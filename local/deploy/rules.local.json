{
  "sources": {
    "local": {
      "name": "本机"
    },
    "workspace": {
      "name": "Workspace 工作台"
    }
  },
  "agents": {
    "claude": {
      "name": "Claude Code",
      "worker": "zhangjiaxingdemacbook-pro",
      "use": "claude",
      "access": "edit"
    },
    "codex": {
      "name": "Codex",
      "worker": "zhangjiaxingdemacbook-pro",
      "use": "codex",
      "access": "edit"
    },
    "dsh": {
      "name": "DeepSeek Harness",
      "worker": "zhangjiaxingdemacbook-pro",
      "use": "dsh",
      "access": "edit"
    },
    "workbuddy-acp": {
      "name": "WorkBuddy ACP",
      "worker": "zhangjiaxingdemacbook-pro",
      "use": "acp",
      "command": ["/Users/zhangjiaxing/.workbuddy/binaries/node/versions/22.22.2-6/bin/codebuddy", "--acp"],
      "access": "edit"
    },
    "workbuddy-command": {
      "name": "WorkBuddy Command",
      "worker": "zhangjiaxingdemacbook-pro",
      "use": "command",
      "command": [
        "/usr/bin/env",
        "UV_ENV_FILE=/Users/zhangjiaxing/.agent-autoloop/agent.env",
        "/Users/zhangjiaxing/.workbuddy/binaries/node/versions/22.22.2-6/bin/node",
        "/Users/zhangjiaxing/.workbuddy/binaries/node/versions/22.22.2-6/bin/codebuddy",
        "-p",
        "{prompt}",
        "--permission-mode",
        "dontAsk",
        "--tools",
        "Read,Write,Edit,Bash,Skill,WebFetch",
        "--settings",
        "/Users/zhangjiaxing/.agent-autoloop/workbuddy-command.settings.json",
        "--setting-sources",
        "project",
        "--output-format",
        "text"
      ],
      "access": "edit"
    }
  },
  "channels": {
    "desktop": {
      "name": "桌面通知"
    }
  },
  "rules": [
    {
      "name": "试一下",
      "when": {
        "source": "local",
        "types": ["try.*"]
      },
      "to": "claude",
      "cwd": "/Users/zhangjiaxing/.agent-autoloop/try",
      "prompt": "这是 agent-autoloop try 的试跑，不要改任何文件，不要做别的事。读资料文件。如果 answers 是空的，就问一个问题：title 写“试跑：选一个颜色”，text 写“这是一次试跑，选哪个都行。”，options 写 [\"蓝色\",\"绿色\"]，key 写 try-color，第一行结论写“问了一个问题”。如果 answers 不是空的，第一行结论写“你选了某某，试跑通过”，把某某换成 answers 里的 chosen（所选那项的文字），不附回执。"
    },
    {
      "name": "URL 内容处理",
      "when": {
        "source": "workspace",
        "types": ["content.url.requested"]
      },
      "to": "workbuddy-command",
      "cwd": "/Users/zhangjiaxing/Documents/workspace/content/.automation/url",
      "skill": "workspace-url",
      "prompt": "按 workspace-url Skill 处理本轮 URL 事件，开始任务，在当前结果目录生成产物，然后通知工作台校验入库。",
      "parallel": 1
    },
    {
      "name": "URL 失败巡检",
      "when": {
        "cron": "0 9 * * *"
      },
      "to": "workbuddy-command",
      "cwd": "/Users/zhangjiaxing/Documents/workspace/content/.automation/url-failure-review",
      "skill": "workspace-url-failure-review",
      "prompt": "按 workspace-url-failure-review Skill 巡检失败 URL 任务。没有 answers 时查询并生成确认卡片；有 answers 时只执行用户选择的重新处理或忽略。不要自动重跑。",
      "parallel": 1
    }
  ],
  "elsewhere": []
}
